[Unit]
Description=proofwork autonomous agent swarm (GenLayer AGENTS economy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/proofwork/swarm
EnvironmentFile=/root/proofwork/swarm/.env
ExecStart=/usr/bin/env bun run bot.ts
Restart=always
RestartSec=10
StandardOutput=append:/var/log/proofwork-swarm.log
StandardError=append:/var/log/proofwork-swarm.log

[Install]
WantedBy=multi-user.target
